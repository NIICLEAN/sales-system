generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  sales  Sale[]
  quotes Quote[]

  assignedWorks WorkSchedule[] @relation("AssignedWorkStaff")
}

model Sale {
  id Int @id @default(autoincrement())

  shopifyOrderId   String?
  shopifyOrderName String?

  customerId        String?
  customerName      String
  customerEmail     String?
  customerVatNumber String?
  customerPhone     String?

  address1 String?
  address2 String?
  city     String?
  county   String?
  postcode String?
  country  String?

  reference     String?
  paymentMethod String

  subtotal      Float   @default(0)
  discountTotal Float   @default(0)
  vatAmount     Float   @default(0)
  total         Float   @default(0)
  amountPaid    Float   @default(0)
  balanceDue    Float   @default(0)
  paymentStatus String  @default("Unpaid")
  depositPaid   Boolean @default(false)

  staffId Int
  staff   Staff @relation(fields: [staffId], references: [id])

  // optional relation to a persisted Customer record
  customerRecordId Int? 
  customerRecord   Customer? @relation(fields: [customerRecordId], references: [id])

  // VAT treatment for this sale
  vatType VatType @default(Standard)

  lineItems SaleLineItem[]

  workSchedules WorkSchedule[]

  createdAt DateTime @default(now())
}

model WorkSchedule {
  id Int @id @default(autoincrement())

  saleId Int?
  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)

  customInvoiceNumber String?
  customCustomerName  String?

  workType WorkType

  scheduledDate DateTime

  assignedStaffId Int
  assignedStaff   Staff @relation("AssignedWorkStaff", fields: [assignedStaffId], references: [id])

  note String?

  createdAt DateTime @default(now())
}

model SaleLineItem {
  id Int @id @default(autoincrement())

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  shopifyVariantId String?
  title            String
  sku              String?
  imageUrl         String?
  quantity         Int @default(1)

  unitPrice Float @default(0)
  discount  Float @default(0)
  lineTotal Float @default(0)

  isCustom Boolean @default(false)

  createdAt DateTime @default(now())
}

model Quote {
  id Int @id @default(autoincrement())

  customerName  String
  customerEmail String?
  customerPhone String?

  address1 String?
  address2 String?
  city     String?
  county   String?
  postcode String?
  country  String?

  reference String?

  subtotal      Float @default(0)
  discountTotal Float @default(0)
  vatAmount     Float @default(0)
  total         Float @default(0)

  staffId Int
  staff   Staff @relation(fields: [staffId], references: [id])

  // optional relation to a persisted Customer record
  customerRecordId Int?
  customerRecord   Customer? @relation(fields: [customerRecordId], references: [id])

  // VAT treatment for this quote
  vatType VatType @default(Standard)

  lineItems QuoteLineItem[]

  createdAt DateTime @default(now())
}

model Customer {
  id        Int      @id @default(autoincrement())
  shopifyId String?  // Shopify customer GID if created in Shopify

  companyName String?
  name        String

  billingAddress1 String?
  billingAddress2 String?
  billingCity     String?
  billingCounty   String?
  billingPostcode String?
  billingCountry  String?

  deliveryAddress1 String?
  deliveryAddress2 String?
  deliveryCity     String?
  deliveryCounty   String?
  deliveryPostcode String?
  deliveryCountry  String?

  email     String?
  mobile    String?
  vatNumber String?

  createdAt DateTime @default(now())

  quotes Quote[]
  sales  Sale[]
}

model Payment {
  id Int @id @default(autoincrement())

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  amount   Float
  method   PaymentMethod
  provider String?   // e.g. MyPOS, Worldpay
  reference String?
  notes    String?

  createdAt DateTime @default(now())
}

enum VatType {
  Standard
  Exempt
  CrossBorder
}

enum PaymentMethod {
  Cash
  Card
  BankTransfer
  Other
}

model QuoteLineItem {
  id Int @id @default(autoincrement())

  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  shopifyVariantId String?
  title            String
  sku              String?

  quantity  Int   @default(1)
  unitPrice Float @default(0)
  discount  Float @default(0)
  lineTotal Float @default(0)

  createdAt DateTime @default(now())
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WorksOrder {
  id Int @id @default(autoincrement())

  customerId        String?
  customerName      String
  customerEmail     String?
  customerPhone     String?
  customerVatNumber String?

  address1 String?
  address2 String?
  city     String?
  county   String?
  postcode String?
  country  String?

  salespersonId   Int
  assignedStaffId Int?

  serviceType String
  extraInfo   String?

  paymentMethod String
  paymentStatus String  @default("unpaid")
  amountPaid    Decimal @default(0)

  subtotal      Decimal
  discountTotal Decimal @default(0)
  vatAmount     Decimal
  total         Decimal

  status        String    @default("awaiting_scheduled")
  scheduledDate DateTime?

  xeroInvoiceId     String?
  xeroInvoiceNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems WorksOrderLineItem[]
}

model WorksOrderLineItem {
  id           Int @id @default(autoincrement())
  worksOrderId Int

  shopifyVariantId String?
  title            String
  sku              String?
  quantity         Int
  unitPrice        Decimal
  discount         Decimal @default(0)
  lineTotal        Decimal

  worksOrder WorksOrder @relation(fields: [worksOrderId], references: [id])
}

model XeroConnection {
  id Int @id @default(autoincrement())

  tenantId String
  tokenSet Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum WorkType {
  Repairs
  Fitting
  CustomBuilds
}