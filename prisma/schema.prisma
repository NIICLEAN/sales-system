generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  sales  Sale[]
  quotes Quote[]
}

model Sale {
  id Int @id @default(autoincrement())

  shopifyOrderId   String?
  shopifyOrderName String?

  customerId        String?
  customerName      String
  customerEmail     String?
  customerVatNumber String?
  customerPhone     String?

  address1 String?
  address2 String?
  city     String?
  county   String?
  postcode String?
  country  String?

  reference     String?
  paymentMethod String

  subtotal      Float   @default(0)
  discountTotal Float   @default(0)
  vatAmount     Float   @default(0)
  total         Float   @default(0)
  amountPaid    Float   @default(0)
  balanceDue    Float   @default(0)
  paymentStatus String  @default("Unpaid")
  depositPaid   Boolean @default(false)

  staffId Int
  staff   Staff @relation(fields: [staffId], references: [id])

  lineItems SaleLineItem[]

  createdAt DateTime @default(now())
}

model SaleLineItem {
  id Int @id @default(autoincrement())

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  shopifyVariantId String?
  title            String
  sku              String?
  quantity         Int     @default(1)

  unitPrice Float @default(0)
  discount  Float @default(0)
  lineTotal Float @default(0)

  isCustom Boolean @default(false)

  createdAt DateTime @default(now())
}

model Quote {
  id Int @id @default(autoincrement())

  customerName  String
  customerEmail String?
  customerPhone String?

  address1 String?
  address2 String?
  city     String?
  county   String?
  postcode String?
  country  String?

  reference String?

  subtotal      Float @default(0)
  discountTotal Float @default(0)
  vatAmount     Float @default(0)
  total         Float @default(0)

  staffId Int
  staff   Staff @relation(fields: [staffId], references: [id])

  lineItems QuoteLineItem[]

  createdAt DateTime @default(now())
}

model QuoteLineItem {
  id Int @id @default(autoincrement())

  quoteId Int
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  shopifyVariantId String?
  title            String
  sku              String?

  quantity  Int   @default(1)
  unitPrice Float @default(0)
  discount  Float @default(0)
  lineTotal Float @default(0)

  createdAt DateTime @default(now())
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WorksOrder {
  id Int @id @default(autoincrement())

  customerId        String?
  customerName      String
  customerEmail     String?
  customerPhone     String?
  customerVatNumber String?

  address1 String?
  address2 String?
  city     String?
  county   String?
  postcode String?
  country  String?

  salespersonId   Int
  assignedStaffId Int?

  serviceType String
  extraInfo   String?

  paymentMethod String
  paymentStatus String  @default("unpaid")
  amountPaid    Decimal @default(0)

  subtotal      Decimal
  discountTotal Decimal @default(0)
  vatAmount     Decimal
  total         Decimal

  status        String    @default("awaiting_scheduled")
  scheduledDate DateTime?

  xeroInvoiceId     String?
  xeroInvoiceNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems WorksOrderLineItem[]
}

model WorksOrderLineItem {
  id           Int @id @default(autoincrement())
  worksOrderId Int

  shopifyVariantId String?
  title            String
  sku              String?
  quantity         Int
  unitPrice        Decimal
  discount         Decimal @default(0)
  lineTotal        Decimal

  worksOrder WorksOrder @relation(fields: [worksOrderId], references: [id])
}

model XeroConnection {
  id Int @id @default(autoincrement())

  tenantId String
  tokenSet Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
